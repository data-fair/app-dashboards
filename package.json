{
  "name": "@data-fair/app-dashboards",
  "type": "module",
  "version": "1.0.8",
  "scripts": {
    "dev": "df-dev-env && dotenv -- zellij --layout .zellij.kdl",
    "dev-server": "df-dev-server",
    "dev-app": "vite",
    "build": "rm -rf dist && PUBLIC_URL=https://cdn.jsdelivr.net/npm/@data-fair/app-dashboards@${npm_package_version}/dist vite build",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "type-check": "vue-tsc --noEmit",
    "build-types": "df-build-types && cp src/config/.type/resolved-schema.json public/config-schema.json",
    "test": "df-dev-env && dotenv -- playwright test --max-failures=1",
    "test-unit": "vitest run",
    "test-e2e": "df-dev-env && dotenv -- playwright test --max-failures=1",
    "quality": "npm run lint && npm run build-types && npm run type-check && npm run build && npm run test-unit && npm run test-e2e && npm audit --omit=dev --audit-level=critical"
  },
  "files": [
    "dist"
  ],
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "@data-fair/frame": "^0.18.6",
    "@data-fair/lib-utils": "^1.13.0",
    "@data-fair/lib-vue": "^1.24.2",
    "@data-fair/lib-vuetify": "^2.3.0",
    "@mdi/js": "^7.4.47",
    "@vueuse/core": "^14.1.0",
    "dayjs": "^1.11.21",
    "ofetch": "^1.3.3",
    "vue": "^3.5.27",
    "vue-i18n": "^11.4.8",
    "vuetify": "^4.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@data-fair/dev-server": "^2.5.2",
    "@data-fair/lib-common-types": "^1.22.0",
    "@data-fair/lib-types-builder": "^1.12.0",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "neostandard": "^0.13.0",
    "sass-embedded": "^1.103.1",
    "typescript": "^5.8.0",
    "vite": "^8.0.14",
    "vite-plugin-vuetify": "^2.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
