{
  "name": "@data-fair/app-dashboards",
  "type": "module",
  "version": "1.1.1",
  "scripts": {
    "dev": "df-dev-env && dotenv -- zellij --layout .zellij.kdl",
    "dev-server": "df-dev-server",
    "dev-app": "vite",
    "build": "rm -rf dist && PUBLIC_URL=https://cdn.jsdelivr.net/npm/@data-fair/app-dashboards@${npm_package_version}/dist vite build",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "type-check": "vue-tsc --noEmit",
    "build-types": "df-build-types src/config",
    "test": "df-dev-env && dotenv -- playwright test --max-failures=1",
    "test-unit": "playwright test --project unit",
    "test-e2e": "df-dev-env && dotenv -- playwright test --project e2e",
    "quality": "npm run lint && npm run build-types && npm run type-check && npm run build && npm run test-unit && npm run test-e2e && npm audit --omit=dev --audit-level=critical"
  },
  "files": [
    "dist"
  ],
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "@data-fair/frame": "^0.19.0",
    "@data-fair/lib-utils": "^1.14.1",
    "@data-fair/lib-vue": "^1.33.0",
    "@data-fair/lib-vuetify": "^2.5.3",
    "@mdi/js": "^7.4.47",
    "@vueuse/core": "^15.0.0",
    "dayjs": "^1.11.23",
    "ofetch": "^1.3.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@data-fair/dev-server": "^2.7.0",
    "@data-fair/lib-common-types": "^1.27.0",
    "@data-fair/lib-types-builder": "^1.14.5",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuetify": "^2.7.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "neostandard": "^0.14.1",
    "sass-embedded": "^1.106.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.1",
    "vue-tsc": "^3.3.13"
  }
}
